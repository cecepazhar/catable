{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CATable",
  "version": "1.0.9",
  "identifier": "com.fathforce.catable",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CATable",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#0e0e0e",
        "additionalBrowserArgs": "--renderer-process-limit=1 --disable-features=Translate,OptimizationHints,MediaRouter --disable-gpu-shader-disk-cache --enable-gpu-rasterization --enable-zero-copy"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Fathforce",
    "copyright": "© 2026 Cecep Saeful Azhar Hidayat",
    "category": "DeveloperTool",
    "shortDescription": "Native multi-driver database studio & local DB service manager",
    "longDescription": "CATable is a fast, native database studio (PostgreSQL, MySQL, MariaDB, SQLite, DuckDB, Redis) with a built-in DBngin-style local database service manager.",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": ["English", "Indonesian"]
      }
    }
  }
}
